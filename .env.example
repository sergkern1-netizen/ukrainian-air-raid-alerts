# alerts.in.ua API Configuration
API_TOKEN=your-alerts-in-ua-api-token-here

# Kafka Brokers (Redpanda)
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094

# TimescaleDB Connection
TIMESCALE_URL=postgresql://postgres:password@localhost:5432/airraids

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# ISW Data Source
ISW_SCRAPE_URL=https://www.understandingwar.org/

# Postgres (consumed by docker-compose; ignored by Settings)
POSTGRES_DB=airraids
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
